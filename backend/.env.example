# Learnova AI Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB URI)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/learnova_ai

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_256bit_secret_string
JWT_EXPIRE=30d

# Frontend Application URL (used for CORS and Password Reset Links)
CLIENT_URL=https://your-domain.com

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Learnova AI <no-reply@your-domain.com>"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini AI API Configuration
AI_API_KEY=your_google_gemini_api_key
